{
  "name": "miniclaw",
  "version": "0.1.0",
  "description": "A lightweight, local-first OpenClaw TUI with Codex as its default agent engine.",
  "type": "module",
  "bin": {
    "miniclaw": "dist/app/cli.js"
  },
  "files": [
    "dist",
    "design/tokens.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/app/cli.tsx",
    "demo": "tsx src/app/cli.tsx --demo",
    "doctor": "tsx src/app/cli.tsx --doctor",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/app/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.267",
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
