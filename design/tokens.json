{
  "name": "reef",
  "version": "0.1.0",
  "description": "miniclaw TUI design tokens — the single source of truth for color, glyphs and motion. See docs/DESIGN.md.",

  "palette": {
    "coral":     { "zh": "珊瑚", "dark": "#FF6B6B", "light": "#C92A2A", "ansi16": "brightRed" },
    "tangerine": { "zh": "橘子", "dark": "#FF9F43", "light": "#B35300", "ansi16": "yellow" },
    "sun":       { "zh": "暖阳", "dark": "#FFD43B", "light": "#8A6500", "ansi16": "brightYellow" },
    "kelp":      { "zh": "海藻", "dark": "#51CF66", "light": "#237A36", "ansi16": "green" },
    "lagoon":    { "zh": "泻湖", "dark": "#22D3EE", "light": "#0B7285", "ansi16": "cyan" },
    "tide":      { "zh": "潮汐", "dark": "#4DABF7", "light": "#1864AB", "ansi16": "brightBlue" },
    "orchid":    { "zh": "兰花", "dark": "#B197FC", "light": "#6741D9", "ansi16": "magenta" },
    "anemone":   { "zh": "海葵", "dark": "#F783AC", "light": "#C2255C", "ansi16": "brightMagenta" }
  },

  "neutral": {
    "muted":         { "dark": "#A6A2BD", "light": "#6B6785", "ansi16": "white" },
    "subtle":        { "dark": "#6F6A88", "light": "#8F8AA8", "ansi16": "brightBlack" },
    "border":        { "dark": "#3B3852", "light": "#D6D3E3", "ansi16": "brightBlack" },
    "surface":       { "dark": "#221F33", "light": "#F3F1FA", "ansi16": null },
    "surfaceStrong": { "dark": "#2E2A45", "light": "#E7E3F5", "ansi16": null },
    "eyeWhite":      { "dark": "#F8F9FA", "light": "#FFFFFF", "ansi16": "brightWhite" },
    "eyeBlack":      { "dark": "#1C1B22", "light": "#1C1B22", "ansi16": "black" }
  },

  "gradient": {
    "reef": ["coral", "tangerine", "sun", "kelp", "lagoon", "tide", "orchid"]
  },

  "semantic": {
    "success":    "kelp",
    "warning":    "sun",
    "error":      "coral",
    "info":       "tide",
    "running":    "lagoon",
    "permission": "tangerine",
    "scheduled":  "orchid"
  },

  "module": {
    "chat":      "lagoon",
    "tasks":     "tide",
    "schedules": "orchid",
    "skills":    "kelp",
    "models":    "anemone",
    "logs":      "muted"
  },

  "profile": {
    "thinker":  "orchid",
    "coder":    "tide",
    "operator": "tangerine",
    "cheap":    "kelp",
    "customHuePool": ["lagoon", "anemone", "sun", "coral"]
  },

  "glyph": {
    "running":    { "unicode": "●", "ascii": "*" },
    "success":    { "unicode": "✓", "ascii": "v" },
    "error":      { "unicode": "✗", "ascii": "x" },
    "warning":    { "unicode": "⚠", "ascii": "!" },
    "permission": { "unicode": "◆", "ascii": "?" },
    "scheduled":  { "unicode": "◷", "ascii": "@" },
    "paused":     { "unicode": "⏸", "ascii": "=" },
    "queued":     { "unicode": "○", "ascii": "o" },
    "retry":      { "unicode": "↻", "ascii": "~" },
    "cancelled":  { "unicode": "⊘", "ascii": "-" },
    "prompt":     { "unicode": "❯", "ascii": ">" },
    "result":     { "unicode": "⎿", "ascii": "`-" },
    "collapsed":  { "unicode": "▸", "ascii": "+" },
    "expanded":   { "unicode": "▾", "ascii": "-" },
    "thread":     { "unicode": "│", "ascii": "|" },
    "default":    { "unicode": "★", "ascii": "*" },
    "sparkle":    { "unicode": "✦", "ascii": "*" },
    "progressFilled": { "unicode": "▰", "ascii": "#" },
    "progressEmpty":  { "unicode": "▱", "ascii": "." }
  },

  "border": {
    "rounded": { "topLeft": "╭", "topRight": "╮", "bottomLeft": "╰", "bottomRight": "╯", "horizontal": "─", "vertical": "│" },
    "heavy":   { "topLeft": "┏", "topRight": "┓", "bottomLeft": "┗", "bottomRight": "┛", "horizontal": "━", "vertical": "┃" },
    "ascii":   { "topLeft": "+", "topRight": "+", "bottomLeft": "+", "bottomRight": "+", "horizontal": "-", "vertical": "|" }
  },

  "spinner": {
    "frames": ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"],
    "asciiFrames": ["|", "/", "-", "\\"],
    "intervalMs": 80
  },

  "motion": {
    "frameIntervalMs": 33,
    "shimmerIntervalMs": 60,
    "welcome": {
      "logoRevealMs": 600,
      "logoShineMs": 500,
      "crabSnipAtMs": [250, 650],
      "crabSnipHoldMs": 120,
      "checkStartMs": 450,
      "checkStaggerMs": 90,
      "checkResolveMs": 220,
      "maxTotalMs": 1400
    }
  },

  "layout": {
    "breakpoints": { "compact": 0, "regular": 66, "wide": 120 },
    "welcomeCrabMinWidth": 86,
    "gutter": 2
  }
}
